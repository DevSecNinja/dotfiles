[user]
	name = {{ .name }}
	email = {{ .email }}

[core]
	editor = vim
	autocrlf = input
	excludesfile = ~/.config/git/ignore
# {{ if .wsl }}
	sshCommand = ssh.exe
# {{ else if eq .chezmoi.os "windows" }}
	sshCommand = "C:/Windows/System32/OpenSSH/ssh.exe"
# {{ end }}

[commit]
	template = ~/.gitmessage
	cleanup = strip

[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

[mergetool "vscode"]
	cmd = code --wait $MERGED

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	default = simple
	autoSetupRemote = true

[color]
	ui = auto

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	unstage = reset HEAD --
	last = log -1 HEAD
	visual = log --oneline --graph --all
	amend = commit --amend --no-edit
	config-list = config --list --show-origin
	ignored = ls-files --ignored --exclude-standard --others
	# Auto-stash, checkout, then pop the stash (mirrors merge/rebase autoStash).
	# Usage: git sco <branch>
	sco = "!f() { \
		if git diff-index --quiet HEAD -- && [ -z \"$(git ls-files --others --exclude-standard)\" ]; then \
			git checkout \"$@\"; \
		else \
			msg=\"auto-stash before checkout $*\"; \
			git stash push --include-untracked -m \"$msg\" >/dev/null && \
			git checkout \"$@\" && \
			git stash pop; \
		fi; \
	}; f"

# {{ if and (eq .chezmoi.os "darwin") (not .codespaces) }}
[credential]
	helper = osxkeychain
# {{ else if eq .chezmoi.os "windows" }}
[credential]
	helper = manager
# {{ else if and (eq .chezmoi.os "linux") (not .codespaces) }}
[credential]
	helper = cache
# {{ end }}

[diff]
	colorMoved = zebra
	tool = vscode

[merge]
	conflictstyle = diff3
	autoStash = true
	tool = vscode

[rebase]
	autoStash = true

[apply]
	whitespace = nowarn
{{ if .useYubiKey }}
# SSH-based commit signing using the FIDO2 SSH key generated by `yk-enroll`
# (see docs/yubikey.md). Activated only when chezmoi `useYubiKey` is true.
#
# `user.signingkey` is a single path — we pick the first per-serial pubkey
# we find (yk-enroll writes id_*_sk_<serial>.pub), falling back to the
# legacy un-suffixed name. `allowed_signers` lists *all* pubkeys so any
# plugged-in YubiKey verifies.
{{- $skEdSerials := glob (joinPath .chezmoi.homeDir ".ssh" "id_ed25519_sk_*.pub") -}}
{{- $skEcSerials := glob (joinPath .chezmoi.homeDir ".ssh" "id_ecdsa_sk_*.pub") -}}
{{- $skEd := joinPath .chezmoi.homeDir ".ssh" "id_ed25519_sk.pub" -}}
{{- $skEc := joinPath .chezmoi.homeDir ".ssh" "id_ecdsa_sk.pub" -}}
{{- $signingKey := "" -}}
{{- if gt (len $skEdSerials) 0 -}}{{- $signingKey = index $skEdSerials 0 -}}
{{- else if stat $skEd -}}{{- $signingKey = $skEd -}}
{{- else if gt (len $skEcSerials) 0 -}}{{- $signingKey = index $skEcSerials 0 -}}
{{- else if stat $skEc -}}{{- $signingKey = $skEc -}}
{{- end }}
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
{{- if $signingKey }}
[user]
	signingkey = {{ $signingKey }}
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- else }}
# No FIDO2 SSH pubkey found yet. Run `yk-enroll` then re-run `chezmoi apply`
# to enable signing.
{{- end }}
{{ else if .gitSigningKey }}
# SSH-based commit signing with the key held by the 1Password SSH agent.
# Signing is delegated to 1Password's own signer binary rather than the local
# ssh-keygen, because the private key never leaves 1Password. The binary is
# platform-specific, and 1Password's "Configure Commit Signing" snippet names a
# different one per platform:
#
#   WSL             op-ssh-sign-wsl.exe   (under /mnt/c, runs on the Windows host)
#   native Windows  op-ssh-sign.exe
#   macOS           op-ssh-sign           (inside the 1Password app bundle)
#
# See docs/git-signing.md. Set `opSshSignProgram` to skip auto-detection.
{{- $signer := "" -}}
{{- if .opSshSignProgram -}}
{{-   $signer = .opSshSignProgram -}}
{{- else if .wsl -}}
{{- /* The signer moved with the 8.11.18 MSIX installer, so probe the current */ -}}
{{- /* location first and fall back to the pre-MSIX one.                     */ -}}
{{-   $localAppData := "" -}}
{{-   if and (lookPath "sh") (lookPath "cmd.exe") -}}
{{-     $windowsLocalAppData := output "sh" "-c" "cmd.exe /d /c 'echo %LOCALAPPDATA%' 2>/dev/null || true" | trim -}}
{{-     if and $windowsLocalAppData (not (contains "%LOCALAPPDATA%" $windowsLocalAppData)) (lookPath "wslpath") -}}
{{-       $localAppData = output "sh" "-c" "wslpath -u \"$1\" 2>/dev/null || true" "sh" $windowsLocalAppData | trim -}}
{{-     end -}}
{{-   end -}}
{{-   if $localAppData -}}
{{-     $candidates := list
          (joinPath $localAppData "Microsoft" "WindowsApps" "op-ssh-sign-wsl.exe")
          (joinPath $localAppData "1Password" "app" "8" "op-ssh-sign-wsl") -}}
{{-     range $candidates -}}
{{-       if and (not $signer) (stat .) -}}{{- $signer = . -}}{{- end -}}
{{-     end -}}
{{-   end -}}
{{- else if eq .chezmoi.os "windows" -}}
{{-   $localAppData := env "LOCALAPPDATA" -}}
{{-   if not $localAppData -}}
{{-     $localAppData = joinPath .chezmoi.homeDir "AppData" "Local" -}}
{{-   end -}}
{{-   $candidates := list
        (joinPath $localAppData "Microsoft" "WindowsApps" "op-ssh-sign.exe")
        (joinPath $localAppData "1Password" "app" "8" "op-ssh-sign.exe") -}}
{{-   range $candidates -}}
{{-     if and (not $signer) (stat .) -}}{{- $signer = . -}}{{- end -}}
{{-   end -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{-   $macSigner := "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" -}}
{{-   if stat $macSigner -}}{{- $signer = $macSigner -}}{{- end -}}
{{- end -}}
{{- /* git config reads backslashes as escapes, so use forward slashes even on */ -}}
{{- /* Windows — which is also the form 1Password's own snippet uses.          */ -}}
{{- $signer = $signer | replace "\\" "/" -}}
{{- /* `user.signingkey` may hold a literal public key or a path; git needs the */ -}}
{{- /* `key::` prefix to read a literal key unambiguously.                      */ -}}
{{- $signingKey := .gitSigningKey | trim -}}
{{- if hasPrefix "ssh-" $signingKey -}}{{- $signingKey = printf "key::%s" $signingKey -}}{{- end }}
{{- if $signer }}
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
	program = "{{ $signer }}"
[user]
	signingkey = {{ $signingKey }}
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- else }}
# gitSigningKey is set but no 1Password signer binary was found, so
# signing is left OFF on purpose.
#
# Turning it on without a signer would make git fall back to the local
# ssh-keygen, which cannot reach the key held by 1Password — every
# `git commit` would fail. Install or update 1Password, or set the chezmoi
# `opSshSignProgram` variable, then re-run `chezmoi apply`.
{{- end }}
{{ end -}}
